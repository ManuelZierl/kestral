{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ManuelZierl/kestral/blob/develop/schemas/external-app-release-evidence.schema.json",
  "title": "Kestral promoted external app release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "app",
    "source",
    "package",
    "host",
    "run",
    "extension_contributions",
    "lifecycle"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "clean"],
      "properties": {
        "repository": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "clean": { "const": true }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest"],
      "properties": {
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_url", "tested_at", "platforms"],
      "properties": {
        "workflow_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "tested_at": { "type": "string", "format": "date-time" },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "extension_contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_app", "extension_point", "contract_version"],
        "properties": {
          "target_app": { "type": "string", "minLength": 1 },
          "extension_point": { "type": "string", "minLength": 1 },
          "contract_version": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_inspection",
        "permission_denial",
        "activation",
        "representative_action",
        "restart",
        "update_data_preservation",
        "disable_enable",
        "keep_data_uninstall",
        "purge_data_uninstall"
      ],
      "properties": {
        "package_inspection": { "$ref": "#/$defs/passedCheck" },
        "permission_denial": { "$ref": "#/$defs/passedCheck" },
        "activation": { "$ref": "#/$defs/passedCheck" },
        "representative_action": { "$ref": "#/$defs/passedCheck" },
        "restart": { "$ref": "#/$defs/passedCheck" },
        "update_data_preservation": { "$ref": "#/$defs/passedCheck" },
        "disable_enable": { "$ref": "#/$defs/passedCheck" },
        "keep_data_uninstall": { "$ref": "#/$defs/passedCheck" },
        "purge_data_uninstall": { "$ref": "#/$defs/passedCheck" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256-[0-9a-f]{64}$"
    },
    "passedCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observation"],
      "properties": {
        "status": { "const": "passed" },
        "observation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
